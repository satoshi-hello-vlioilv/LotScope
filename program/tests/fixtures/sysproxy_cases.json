{
  "about": "CM3 のシステムのプロキシの読み方の事例（版 3.117.1。人が仕様〈Python 3.13 の urllib.request の getproxies・proxy_bypass と Windows の Internet Settings〉と利用者の決め 2026-11-17 から書いた表）。env・bypass・choose・pac の事例は、同じ環境変数とレジストリの値に posix と nt （Windows）の 2 つの答えを持つ（版 3.117.1 の作った後の直し: 前は 1 つの事例に nt の印と 1 つの答えで、印の無い事例を Windows の Python で 流すと os.environ が名前を大文字にして別の答えになった）。Python は tests/test_sysproxy_cases.py が urllib の関数を直に当て（os.environ は 事例の表の dict に差し替える。nt は Windows の os.environ と同じく名前を大文字にして後ろの値が勝つ。Windows の関数は Linux では urllib の元の字から組む）、窓は cargo test --test sysproxy_cases が src/sysproxy.rs を当てる（nt を選ぶ純粋な関数）。どちらもどの OS で 流しても同じ答え。env は環境変数の並び（OS の並び）、reg は HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings の値（数は DWORD、字は SZ。無い値は書かない。reg が null は鍵が無い。posix の答えは reg を読まない）",
  "decisions": [
    "認証は無い（利用者の決め）: プロキシの URL の 利用者:合言葉 は送らない（Proxy-Authorization を付けない）。urllib は送る",
    "https:// と書いたプロキシも http のプロキシとして使う（窓は TLS でプロキシにつながない。Windows の既定の種類と同じ）。urllib は http の問い合わせを TLS でプロキシへ送る",
    "socks などほかの種類のプロキシと、読めないプロキシの URL・番号は、取りに行く前に言葉で断る。urllib は「unknown url type」か ValueError・InvalidURL で落ちる（500）",
    "PAC と自動検出は読まない（利用者の決め）。Windows で環境変数のプロキシが無く、ProxyEnable が 0 で AutoConfigURL があるときは、届かない言葉に「（プロキシの自動設定〈PAC〉には対応していません）」を足す",
    "読む順は urllib のまま: 環境変数が 1 つでもあれば（no_proxy だけでも）Windows の設定を読まない。no_proxy は環境変数のプロキシがあるときだけ、ProxyOverride は無いときだけ見る",
    "30x のたびに行き先の名前で選び直す（urllib の ProxyHandler と同じ。schedule_parity の「30x のたびにプロキシを決め直す」）"
  ],
  "env": [
    {"name": "小文字の名前が勝つ", "env": [["http_proxy", "http://low:1"], ["HTTP_PROXY", "http://up:2"]], "want": {"posix": [["http", "http://low:1"]], "nt": [["http", "http://up:2"]]}},
    {"name": "大文字だけ", "env": [["HTTPS_PROXY", "http://up:2"]], "want": {"posix": [["https", "http://up:2"]], "nt": [["https", "http://up:2"]]}},
    {"name": "空の小文字は大文字も消す", "env": [["HTTP_PROXY", "http://up:2"], ["http_proxy", ""]], "want": {"posix": [], "nt": []}},
    {"name": "空の大文字は無視", "env": [["HTTP_PROXY", ""], ["https_proxy", "http://p:3"]], "want": {"posix": [["https", "http://p:3"]], "nt": [["https", "http://p:3"]]}},
    {"name": "混ぜた大文字小文字は 1 回目だけ", "env": [["Http_Proxy", "http://mix:4"]], "want": {"posix": [["http", "http://mix:4"]], "nt": [["http", "http://mix:4"]]}},
    {"name": "REQUEST_METHOD は大文字の HTTP_PROXY を捨てる", "env": [["REQUEST_METHOD", "GET"], ["HTTP_PROXY", "http://up:2"]], "want": {"posix": [], "nt": []}},
    {"name": "REQUEST_METHOD でも小文字は使う", "env": [["REQUEST_METHOD", "GET"], ["http_proxy", "http://low:1"]], "want": {"posix": [["http", "http://low:1"]], "nt": []}},
    {"name": "no_proxy も読む", "env": [["no_proxy", "localhost,.corp"]], "want": {"posix": [["no", "localhost,.corp"]], "nt": [["no", "localhost,.corp"]]}},
    {"name": "関係のない名前も *_proxy なら読む", "env": [["foo_proxy", "x"]], "want": {"posix": [["foo", "x"]], "nt": [["foo", "x"]]}},
    {"name": "_proxy で終わらない名前（「_proxy」だけは種類が空の名前）", "env": [["proxy", "x"], ["httpproxy", "y"], ["_proxy", "z"]], "want": {"posix": [["", "z"]], "nt": [["", "z"]]}},
    {"name": "Windows は名前を大文字で読む（小文字の 2 回目は効かない）", "env": [["http_proxy", "http://low:1"]], "want": {"posix": [["http", "http://low:1"]], "nt": [["http", "http://low:1"]]}},
    {"name": "Windows は空の値で消さない（大文字の名前）", "env": [["https_proxy", "http://p:3"], ["http_proxy", ""]], "want": {"posix": [["https", "http://p:3"]], "nt": [["https", "http://p:3"]]}},
    {"name": "Windows の REQUEST_METHOD は小文字の http_proxy も捨てる", "env": [["request_method", "GET"], ["http_proxy", "http://low:1"]], "want": {"posix": [["http", "http://low:1"]], "nt": []}}
  ],
  "registry": [
    {"name": "1 つの値はすべての種類", "reg": {"ProxyEnable": 1, "ProxyServer": "proxy.corp:8080"}, "want": [["http", "http://proxy.corp:8080"], ["https", "http://proxy.corp:8080"], ["ftp", "http://proxy.corp:8080"]]},
    {"name": "ProxyEnable が 0", "reg": {"ProxyEnable": 0, "ProxyServer": "proxy.corp:8080"}, "want": []},
    {"name": "ProxyEnable が無い", "reg": {"ProxyServer": "proxy.corp:8080"}, "want": []},
    {"name": "鍵が無い", "reg": null, "want": []},
    {"name": "ProxyServer が無い", "reg": {"ProxyEnable": 1}, "want": []},
    {"name": "ProxyEnable が字の 0（字は空でなければ真）", "reg": {"ProxyEnable": "0", "ProxyServer": "p:1"}, "want": [["http", "http://p:1"], ["https", "http://p:1"], ["ftp", "http://p:1"]]},
    {"name": "種類ごと", "reg": {"ProxyEnable": 1, "ProxyServer": "http=hp:80;https=sp:443"}, "want": [["http", "http://hp:80"], ["https", "http://sp:443"]]},
    {"name": "種類の付いた address はそのまま", "reg": {"ProxyEnable": 1, "ProxyServer": "http=http://hp:80;https=https://sp:443"}, "want": [["http", "http://hp:80"], ["https", "https://sp:443"]]},
    {"name": "socks だけ（http・https にも socks4）", "reg": {"ProxyEnable": 1, "ProxyServer": "socks=sk:1080"}, "want": [["socks", "socks://sk:1080"], ["http", "socks4://sk:1080"], ["https", "socks4://sk:1080"]]},
    {"name": "socks と http", "reg": {"ProxyEnable": 1, "ProxyServer": "http=hp:80;socks=sk:1080"}, "want": [["http", "http://hp:80"], ["socks", "socks://sk:1080"], ["https", "socks4://sk:1080"]]},
    {"name": "「=」の無い段で止まる（それまでの物）", "reg": {"ProxyEnable": 1, "ProxyServer": "http=hp:80;garbage;https=sp:443"}, "want": [["http", "http://hp:80"]]},
    {"name": "後ろの ; の空の段で止まる", "reg": {"ProxyEnable": 1, "ProxyServer": "http=hp:80;"}, "want": [["http", "http://hp:80"]]},
    {"name": "前の空白は種類の名前に残る（https に効かない）", "reg": {"ProxyEnable": 1, "ProxyServer": "http=hp:80; https=sp:443"}, "want": [["http", "http://hp:80"], [" https", "sp:443"]]},
    {"name": "大文字の種類は種類を付けない", "reg": {"ProxyEnable": 1, "ProxyServer": "HTTP=hp:80"}, "want": [["HTTP", "hp:80"]]},
    {"name": "ProxyServer が数", "reg": {"ProxyEnable": 1, "ProxyServer": 5}, "want": [["http", "http://5"], ["https", "http://5"], ["ftp", "http://5"]]}
  ],

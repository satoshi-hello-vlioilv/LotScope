    {"name": "ProxyOverride の * と ; と空白", "env": [], "reg": {"ProxyEnable": 1, "ProxyServer": "p:1", "ProxyOverride": "www.example.com; *.corp ;10.*"}, "host": "cm3.corp:9085", "want": {"posix": false, "nt": true}},

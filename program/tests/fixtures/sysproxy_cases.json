    {"name": "https には https_proxy", "env": [["http_proxy", "http://a:1"], ["https_proxy", "http://b:2"]], "url_type": "https", "host": "cm3:443", "want": {"posix": "b:2", "nt": "b:2"}},
    {"name": "https_proxy が無ければ https は直", "env": [["http_proxy", "http://a:1"]], "url_type": "https", "host": "cm3:443", "want": {"posix": null, "nt": null}},

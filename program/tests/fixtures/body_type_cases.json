  {
   "name": "名前が字",
   "method": "POST",
   "path": "/api/card-forms",
   "raw": "{\"name\": \"a\", \"body\": {}}",
   "want": {
    "ok": true
   }
  },
  {
   "name": "名前が数（今どおり str() で受ける）",
   "method": "POST",
   "path": "/api/card-forms",
   "raw": "{\"name\": 1.5, \"body\": {}}",
   "want": {
    "ok": true
   }
  },
  {

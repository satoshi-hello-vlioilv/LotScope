  {"path": "/api/lotlist/pivot", "conv": true, "need": ["lot_list", "sources", "conversions"]},
  {"path": "/api/lotlist/source", "conv": false, "need": ["lot_list", "sources"]},
  {"path": "/api/worklog", "conv": false, "need": ["work", "shifts", "sources"]},
  {"path": "/api/worklog/slicer", "conv": true, "need": ["work", "shifts", "sources", "conversions"]},
  {"path": "/api/src/wip", "conv": false, "need": ["sources", "lot_list"]},
  {"path": "/api/dashboard/sources", "conv": false, "need": ["dash", "sources", "work"]},
  {"path": "/api/dashboard/query", "conv": false, "need": ["lot_list", "dash", "sources", "work", "shifts"]},
  {"path": "/api/dashboard/query", "conv": true, "need": ["lot_list", "dash", "sources", "work", "shifts", "conversions"]},
  {"path": "/api/dashboard/equip-tree", "conv": false, "need": ["lot_list", "dash", "sources", "work", "shifts"]},
  {"path": "/api/masters/shifts", "conv": false, "need": []},
  {"path": "/api/heartbeat", "conv": false, "need": []},
  {"path": "/api/sources", "conv": false, "need": []}
 ]
}

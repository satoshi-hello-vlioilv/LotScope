   "after": [{"id": 1, "名前": "管理分類", "入力": "[]", "判定": "[{\"when\": {}, \"out\": \"並純箔\"}]", "その他": "", "当て方": "{}", "表示順": "10", "rev": 2, "updated_at": "2026-11-27T09:00:00", "updated_by": "PC-02"}, {"id": 2, "名前": "課名", "入力": "[]", "判定": "[{\"when\": {}, \"out\": \"生産管理\"}]", "その他": "", "当て方": "{}", "表示順": "20", "rev": 1, "updated_at": "2026-11-26T11:35:00", "updated_by": "PC-01"}],
   "want": false},

   "after": [{"id": 1, "名前": "管理分類", "入力": "[]", "判定": "[{\"when\": {}, \"out\": \"並純箔\"}]", "その他": "", "当て方": "{}", "表示順": "10", "rev": 1, "updated_at": "2026-11-26T11:35:00", "updated_by": "PC-01"}],
